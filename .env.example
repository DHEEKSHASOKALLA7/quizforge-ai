# Everything is optional. With none of these set, uploads still work (offline extractive question generator).
# Ollama is auto-detected at http://127.0.0.1:11434. Only set these to change the defaults.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
# ANTHROPIC_API_KEY=
# MODEL=claude-sonnet-4-5
JWT_SECRET=change-me
# DATABASE_URL=
# REDIS_URL=
# GEN_BUDGET_MS=170000    # max time spent on AI calls per quiz before the offline generator fills the rest
# LLM_TIMEOUT_MS=180000   # per AI call
